# Ключ API. В код не зашивается никогда.
CREDITGO_API_KEY=

# Домен. Прод и тест — один и тот же, тестируйте на безопасном credit_id.
CREDITGO_BASE_URL=https://api.crm-lending.example

# Экспорт с остатками по кредитам (l_*, r_*).
CREDITGO_EXPORT_ID=229

# Как передавать ключ: header (x-api-key, как просит спека) или query (?apiKey=).
CREDITGO_AUTH_MODE=header

# Как передавать параметры отписа: body (JSON) или query.
# Спека таблицей не различает; body — вариант из прежнего рабочего кода.
CREDITGO_WRITEOFF_TRANSPORT=body

# Кто проводит операцию — уходит в notes отписа и в аудит-лог.
CREDITGO_ACTOR=

# Куда писать аудит (JSONL). Пишется всегда, независимо от флага ниже.
CREDITGO_AUDIT_DIR=./audit

# Отказывать при повторной проводке (already_applied / dangling_intent).
# Выключено: CRM сам не даёт провести один и тот же отпис дважды.
CREDITGO_IDEMPOTENCY_GUARD=false

# Допуск сверки «сумма корзин vs debt», в haléřích. 0 = любое расхождение блокирует.
CREDITGO_DEBT_TOLERANCE=0

CREDITGO_HTTP_TIMEOUT_MS=30000
