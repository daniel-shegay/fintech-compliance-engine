# ==============================================================================
# Fintech Compliance Engine — Environment Configuration
# ==============================================================================

# Server Settings
PORT=3000
NODE_ENV=development

# JWT Authentication
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_with_a_secure_random_32_byte_hex_string
JWT_EXPIRES=8h

# Core CRM API Integration (Export & Write-off endpoints)
API_KEY=your_crm_api_key_here
API_BASE_URL=https://api.crm-lending.example/api/v1.0/export/export

# Loan sold / assigned to collections detection keywords (comma-separated)
SOLD_STATUS_KEYWORDS=prodán,prodáno,prodana,sold,postoupeno,postoupená

# Demo & Mock Mode (Enabled by default if no valid API_KEY is provided)
# Set to 'true' to run fully offline with rich synthetic loan fixtures
MOCK_MODE=true

# Write-off Module Overrides (Optional)
CREDITGO_EXPORT_ID=229
CREDITGO_AUTH_MODE=header
CREDITGO_WRITEOFF_TRANSPORT=body
CREDITGO_AUDIT_DIR=./audit
CREDITGO_IDEMPOTENCY_GUARD=false
CREDITGO_DEBT_TOLERANCE=0
